#!/bin/bash
# Vérifie les 3 services de Marché et nginx ; journalise, et sort en erreur si l'un est KO.
# Planifié par /etc/cron.d/marche toutes les 5 minutes.
set -uo pipefail          # pas de -e : on veut tester TOUS les services, même si le premier échoue

LOG=/var/log/marche/health.log
statut=0

journaliser() { echo "$(date '+%F %T') $*" >> "$LOG"; }

for svc in gateway:8000 orders:8001 payments:8002; do
    nom=${svc%%:*}
    port=${svc##*:}
    if curl -fsS -m 5 -o /dev/null "http://127.0.0.1:$port/healthz"; then
        journaliser "$nom OK"
    else
        journaliser "$nom KO"
        statut=1
    fi
done

# La vue du client : à travers nginx
if curl -fsS -m 5 -o /dev/null "http://127.0.0.1/api/products"; then
    journaliser "nginx OK"
else
    journaliser "nginx KO"
    statut=1
fi

[ "$statut" -eq 0 ] || echo "marche-healthcheck : au moins un composant KO, voir $LOG" >&2
exit "$statut"
