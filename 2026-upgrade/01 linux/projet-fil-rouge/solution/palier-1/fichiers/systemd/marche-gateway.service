[Unit]
Description=Marché — service gateway (API publique, derrière nginx)
Wants=marche-orders.service
After=network.target marche-orders.service

[Service]
Type=simple
User=marche
Group=marche
WorkingDirectory=/opt/marche/app
Environment=SERVICE_NAME=gateway
ExecStart=/opt/marche/venv/bin/python gateway.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
