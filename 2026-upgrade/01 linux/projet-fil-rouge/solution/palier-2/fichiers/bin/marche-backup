#!/bin/bash
# Palier 2 : sauvegarde lancée par marche-backup.timer (02:30) ou « marchectl backup ».
#   1. dump de la base :          /var/backups/marche/marche-<date>.sql.gz    (7 derniers)
#   2. instantané de la config :  /var/backups/marche/config/<date>/          (14 derniers)
#      en rsync --link-dest : les fichiers inchangés ne prennent aucune place
set -Eeuo pipefail

DEST=/var/backups/marche
LOG=/var/log/marche/backup.log
date=$(date +%F_%H%M%S)
journaliser() { echo "$(date '+%F %T') $*" >> "$LOG"; }
trap 'journaliser "ÉCHEC ligne $LINENO (code $?) : $BASH_COMMAND"' ERR

exec 9>/run/marche-backup.lock
flock -n 9 || { journaliser "ABANDON : une sauvegarde est déjà en cours"; exit 1; }
mountpoint -q "$DEST" || { journaliser "ABANDON : $DEST n'est pas monté (volume lv_backups)"; exit 1; }

# 1. Base de données
fichier="$DEST/marche-$date.sql.gz"
runuser -u postgres -- pg_dump --no-owner marche | gzip > "$fichier.tmp"
mv "$fichier.tmp" "$fichier" && chmod 640 "$fichier"
ls -1t "$DEST"/marche-*.sql.gz | tail -n +8 | xargs -r rm --

# 2. Configuration et code en service (sans le venv, reconstructible)
install -d -m 750 "$DEST/config"
ref=()
[ -L "$DEST/config/latest" ] && ref=(--link-dest="$(readlink -f "$DEST/config/latest")")
rsync -a --delete --relative "${ref[@]}" --exclude 'venv/' \
    /etc/marche /etc/nginx /etc/nftables.conf /etc/systemd/system/marche* /opt/marche/current/ \
    "$DEST/config/$date/"
ln -sfn "$DEST/config/$date" "$DEST/config/latest"
ls -1dt "$DEST"/config/20* | tail -n +15 | xargs -r rm -rf --

journaliser "SUCCÈS $fichier ($(du -h "$fichier" | cut -f1)) + config/$date"
