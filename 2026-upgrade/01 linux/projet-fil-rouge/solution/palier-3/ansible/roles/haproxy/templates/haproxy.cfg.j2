# Géré par Ansible (rôle haproxy) — {{ inventory_hostname }}
global
    log /dev/log local0
    stats socket /run/haproxy/admin.sock mode 660 level admin
    user haproxy
    group haproxy
    daemon
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    option  forwardfor
    timeout connect 5s
    timeout client  30s
    timeout server  30s
    # Si un serveur tombe EN COURS de requête, réessayer sur l'autre
    retries 2
    option  redispatch

# Écoute sur TOUTES les adresses (*) : la même configuration fonctionne sur le répartiteur
# qui porte l'IP virtuelle et sur celui qui l'attend.
frontend marche_http
    bind *:80
    http-request redirect scheme https code 301

frontend marche_https
    bind *:443 ssl crt /etc/haproxy/certs/marche.pem alpn h2,http/1.1
    http-response set-header Strict-Transport-Security "max-age=31536000"
    http-request deny if { path_beg /admin }
    default_backend marche_web

backend marche_web
    balance roundrobin
    # /sante passe par orders jusqu'à PostgreSQL : un web qui ne joint plus la base sort du lot
    option httpchk GET /sante
    http-check expect status 200
    default-server inter 2s fall 2 rise 2
{% for h in groups['web'] %}
    server {{ h }} {{ hostvars[h]['ansible_host'] }}:80 check
{% endfor %}

# Tableau de bord, en local seulement (tunnel SSH pour le voir)
listen stats
    bind 127.0.0.1:8404
    stats enable
    stats uri /
    stats refresh 5s
