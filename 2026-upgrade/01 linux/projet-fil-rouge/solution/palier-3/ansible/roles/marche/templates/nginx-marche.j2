# Géré par Ansible (rôle marche) — {{ inventory_hostname }}
# HTTP seulement : TLS est terminé par HAProxy sur les répartiteurs, seuls clients autorisés.
server {
    listen 80 default_server;
    server_name _;
    server_tokens off;

    # L'adresse du VRAI client, transmise par HAProxy (sinon tous les journaux montrent lb1/lb2)
{% for h in groups['lb'] %}
    set_real_ip_from {{ hostvars[h]['ansible_host'] }};
{% endfor %}
    real_ip_header X-Forwarded-For;

    access_log /var/log/nginx/marche.access.log;
    error_log  /var/log/nginx/marche.error.log;

    # Contrôle de santé des répartiteurs : passe par orders, donc prouve l'accès à la base
    location = /sante {
{% for h in groups['lb'] %}
        allow {{ hostvars[h]['ansible_host'] }};
{% endfor %}
        allow 127.0.0.1;
        deny all;
        proxy_pass http://127.0.0.1:8001/healthz;
    }

    location /admin/ {
        deny all;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 15s;
    }
}
