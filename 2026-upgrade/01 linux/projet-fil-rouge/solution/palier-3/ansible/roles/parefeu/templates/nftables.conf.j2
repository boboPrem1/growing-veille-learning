#!/usr/sbin/nft -f
# Géré par Ansible (rôle parefeu) — {{ inventory_hostname }} ({{ group_names | join(', ') }})
# Pas de « flush ruleset » : fail2ban (et Docker, dans le lab) ont leurs propres tables.
{% macro adresses(groupe) -%}
{{ groups[groupe] | map('extract', hostvars, 'ansible_host') | join(', ') }}
{%- endmacro %}
table inet filtre
delete table inet filtre

table inet filtre {
    chain entree {
        type filter hook input priority filter; policy drop;

        iif lo accept
        ct state established,related accept
        ct state invalid drop
        meta l4proto { icmp, ipv6-icmp } accept

        # Administration : uniquement depuis la passerelle du lab et le poste de contrôle
        tcp dport 22 ip saddr { {{ reseau_admin | join(', ') }} } accept
{% if 'lb' in group_names %}

        # Répartiteur : le site est public
        tcp dport { 80, 443 } accept
        # VRRP (keepalived) : uniquement depuis l'autre répartiteur
        ip protocol vrrp ip saddr { {{ groups['lb'] | difference([inventory_hostname]) | map('extract', hostvars, 'ansible_host') | join(', ') }} } accept
{% endif %}
{% if 'web' in group_names %}

        # Serveur web : joignable UNIQUEMENT par les répartiteurs
        tcp dport 80 ip saddr { {{ adresses('lb') }} } accept
{% endif %}
{% if 'db' in group_names %}

        # PostgreSQL : UNIQUEMENT les serveurs web
        tcp dport 5432 ip saddr { {{ adresses('web') }} } accept
{% endif %}
{% if 'wireguard' in group_names %}

        # WireGuard : uniquement depuis l'autre extrémité du tunnel
        udp dport {{ wg_port }} ip saddr { {{ groups['wireguard'] | difference([inventory_hostname]) | map('extract', hostvars, 'ansible_host') | join(', ') }} } accept
{% endif %}
{% if 'bak' in group_names %}
        # Dépôt de sauvegardes : SSH (sftp) seulement à travers le tunnel
        iifname "wg0" tcp dport 22 accept
{% endif %}

        limit rate 5/minute log prefix "nft-refuse: " level info
        counter comment "paquets refusés"
    }

    chain transfert {
        type filter hook forward priority filter; policy drop;
    }

    chain sortie {
        type filter hook output priority filter; policy accept;
    }
}
