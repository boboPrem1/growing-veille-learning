# /etc/marche/marche.env — commun aux trois services (à copier et adapter)
DATABASE_URL=postgresql://marche:MOT_DE_PASSE@ADRESSE_DE_LA_BASE:5432/marche
ORDERS_URL=http://127.0.0.1:8001
PAYMENTS_URL=http://127.0.0.1:8002
LISTEN_HOST=127.0.0.1
LOG_LEVEL=INFO
# Propre à un service : /etc/marche/gateway.env, par exemple  LISTEN_HOST=0.0.0.0
